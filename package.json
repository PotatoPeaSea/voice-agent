{
  "name": "voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "chat": "tsx src/tools/chat.ts",
    "tts": "cd services/qwen-tts && uv run server.py",
    "check": "tsx src/tools/check.ts",
    "voices": "tsx src/tools/list-voices.ts",
    "clone-voice": "tsx src/tools/clone-voice.ts",
    "agent:probe": "tsx src/tools/acp-probe.ts",
    "agent:smoke": "tsx src/tools/agent-smoke.ts",
    "spike": "tsx src/spike/m0-voice.ts",
    "channels": "tsx src/spike/list-channels.ts",
    "deps:report": "tsx src/spike/deps-report.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.2",
    "@agentclientprotocol/sdk": "^1.5.0",
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.3",
    "libsodium-wrappers": "^0.8.4",
    "openai": "^7.23.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
