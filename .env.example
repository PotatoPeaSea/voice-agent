# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# Right-click server / voice channel / yourself with Developer Mode on -> Copy ID
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to talk to the bot
ALLOWED_USER_IDS=
# Follow allowed users into voice and leave when the channel empties (default true).
# false = join DISCORD_VOICE_CHANNEL_ID at startup; move only with /join and /leave.
VOICE_AUTO_JOIN=
# The assistant's name, told to the model so it answers to it (e.g. Veronica). Blank = no name.
ASSISTANT_NAME=
# Wake word mode: the bot ignores you until you say one of these (comma-separated, any case/punctuation),
# then talks normally until WAKE_IDLE_SECONDS (default 120) pass with nothing said, or until you tell it you're
# done ("ok we're done"), then says it's going quiet. Blank = always listening.
# Including the bare name too ("hey veronica,veronica") helps when speech recognition drops the "hey".
WAKE_WORDS=
WAKE_IDLE_SECONDS=

# --- milestone 1: conversation ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Local Qwen3-TTS service (services/qwen-tts)
QWEN_TTS_URL=http://127.0.0.1:8765
# Alibaba Cloud Model Studio key for Qwen3-TTS cloud fallback; region intl or cn
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=intl
CARTESIA_API_KEY=
STT_PROVIDER=deepgram-flux
# Reasoning adds seconds of latency; leave off for voice
LLM_THINKING=false

# --- task reports in Discord text ---
# Text channel where each task gets a thread with live progress and its full report.
# Blank = post into the voice channel's own text chat (no threads).
# The bot needs View Channel, Send Messages, Create Public Threads, Send Messages in Threads, Attach Files.
DISCORD_REPORTS_CHANNEL_ID=

# --- lookups without an agent (files, git, MCP tools, quick_agent) ---
# Seconds to wait for a lookup before it carries on in the background (default 3).
TOOL_WAIT_SECONDS=
# MCP servers the voice model calls directly. Default: config/mcp.yaml (ships with Exa web search).
MCP_CONFIG=

# --- Claude Code agents (via ACP) ---
# Folders agents may work in, comma-separated. Default: the folder containing this project.
WORKER_ROOTS=
# Fallback model/effort when the voice model doesn't pick one (it normally chooses per task).
# CLAUDE_MODE=auto is recommended for voice: Claude decides permissions instead of asking you for each command.
CLAUDE_MODE=
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
# Models agents may never use (substring match). Default: haiku
CLAUDE_BLOCKED_MODELS=haiku

# --- Hermes Agent as a second worker (optional, via its ACP server) ---
# Set to the command that starts it, e.g. hermes-acp. Blank/off = Claude Code only.
HERMES_ACP_COMMAND=
# Fallback model as provider:model (see `npm run agent:smoke -- hermes`). Blank = Hermes's configured default.
HERMES_MODEL=
# default (asks before edits), accept_edits or dont_ask
HERMES_MODE=

# --- hold music while agents work (optional) ---
# Plays in voice after a task is dispatched and the call goes quiet; stops the moment anyone speaks,
# a task reports back, or no task is running. Needs ffmpeg on PATH. true/false (default true).
MUSIC_ENABLED=
# An audio file or a folder of them (mp3, wav, ogg, flac, m4a...). Default: ./music. Missing = no music.
MUSIC_PATH=
# Seconds of quiet before the music starts (default 5), and its volume 0-1 (default 0.2).
MUSIC_DELAY_SECONDS=
MUSIC_VOLUME=
# Volume 0-1 of songs asked for by voice ("play Moonlight"; default 0.5). They come from MUSIC_PATH
# even when MUSIC_ENABLED=false.
MUSIC_SONG_VOLUME=
